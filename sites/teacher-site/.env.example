# Drizzle / Database (Offline Local SQLite Fallback via LibSQL)
# Live Turso credentials are not required for local development.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=""

# Server Origin (Optional for local development)
TEACHER_ORIGIN=http://localhost:5174

# Better Auth
# Non-sensitive development secret (minimum 32 characters)
BETTER_AUTH_SECRET="dev_secret_at_least_32_characters_long_for_local_development"

# Google OAuth (Optional for local development; leave empty if not testing Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

